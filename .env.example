# LUXEM RENT A CAR — Backend Environment Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://luxem:luxem@localhost:5433/luxem?schema=public

# Frontend URL (para CORS y enlaces de correos)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Sesiones de usuario
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
SWAGGER_ENABLED=true
JOBS_ENABLED=true

# Almacenamiento (local para dev, s3 para producción/Railway)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Configuración S3 / Cloudflare R2 (necesario en producción)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=luxem-files
# S3_ACCESS_KEY_ID=tu_access_key
# S3_SECRET_ACCESS_KEY=tu_secret_key
# S3_FORCE_PATH_STYLE=true

# Correo (console para dev, smtp o resend para producción)
MAIL_DRIVER=console
MAIL_FROM="LUXEM RENT A CAR <no-reply@luxemrentacar.com>"
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_tu_api_key
# RESEND_API_KEY=re_tu_api_key
